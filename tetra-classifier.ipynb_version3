    "# =========================\n",
    "# CELL 3: LOAD IMAGES\n",
    "# =========================\n",
    "\n",
    "def get_images(path, exts=(\"jpg\",\"png\",\"jpeg\",\"tif\")):\n",
    "    files = []\n",
    "    for ext in exts:\n",
    "        files.extend(glob(f\"{path}/**/*.{ext}\", recursive=True))\n",
    "    return files\n",
    "\n",
    "# Leukemia (merge subtypes)\n",
    "leukemia_imgs = []\n",
    "for cls in [\"ALL\",\"AML\",\"CLL\",\"CML\"]:\n",
    "    leukemia_imgs += get_images(f\"{LEUKEMIA_PATH}/**/{cls}\")\n",
    "\n",
    "# Healthy\n",
    "healthy_imgs = get_images(f\"{LEUKEMIA_PATH}/**/H\")\n",
    "\n",
    "# Lymphoma\n",
    "lymphoma_imgs = get_images(LYMPHOMA_PATH, (\"tif\",\"jpg\",\"png\"))\n",
    "\n",
    "# Myeloma (IMPORTANT: filter out masks)\n",
    "myeloma_imgs = get_images(MYELOMA_PATH, (\"jpg\",\"png\"))\n",
    "myeloma_imgs = [img for img in myeloma_imgs if \"mask\" not in img.lower()]\n",
    "\n",
    "print(\"Counts:\")\n",
    "print(\"Leukemia:\", len(leukemia_imgs))\n",
    "print(\"Healthy:\", len(healthy_imgs))\n",
    "print(\"Lymphoma:\", len(lymphoma_imgs))\n",
    "print(\"Myeloma:\", len(myeloma_imgs))"
   ]
